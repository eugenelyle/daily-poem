# Daily Poem — overnight companion selection. Pi only. See README "The companion (page 2)".
# Install: copy both unit files to /etc/systemd/system/, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now daily-companion.timer
#
# Runs the companion pipeline for TODAY's poem (same Notion source + deterministic
# date pick as the 06:00 render, so the companion matches the morning's poem) and
# writes out/companion.{png,json}. It does NOT push to the panel — the button
# server (page 2) reads those files on demand.
#
# Needs ANTHROPIC_API_KEY in addition to NOTION_TOKEN. Add it to the same env file:
#   umask 077; printf 'ANTHROPIC_API_KEY=%s\n' '<your-key>' >> /home/pi/daily-poem.env
[Unit]
Description=Daily Poem — select the companion for today's poem (page 2)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/daily-poem
Environment=DAILY_POEM_BACKEND=notion
EnvironmentFile=/home/pi/daily-poem.env
ExecStart=/home/pi/daily-poem/.venv/bin/python -m daily_poem companion
