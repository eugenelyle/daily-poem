# Fire at 01:00 local — five hours before the 06:00 render — so the companion is
# selected and rendered well before the morning button press. The overnight slot
# is deliberate: nothing is time-critical, so there's room to pull fresh sources
# and render-test images (see handoff §4). `Persistent=true` catches up a missed
# run if the Pi was asleep.
[Unit]
Description=Select the Daily Poem companion once each night

[Timer]
OnCalendar=*-*-* 01:00:00
Persistent=true

[Install]
WantedBy=timers.target
